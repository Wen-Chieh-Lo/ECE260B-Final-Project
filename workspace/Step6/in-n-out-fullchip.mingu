# =============================================================================
#
#   in-n-out-fullchip.mingu  —  RTL Simulation Command Script (fullchip_shell)
#
#   Dual-core fullchip: writeK0/writeK1 for separate K per core.
#
#   USAGE: ./sim_shell.sh -f in-n-out-fullchip.mingu
#
#   set_clock_period <ns0> [ns1] — clk0 / clk1 full period (ns); ns1 defaults to ns0
#
# =============================================================================

set PATTERN sim/pattern
set_output_dir sim/waveform
set_sim_stage sim
set_clock_period 1 10
set_sim_define SFP_LONGDIV SFP_THRESHOLD=169503
set_scope fullchip
fix_set

# Test 1: Q*K^T
set_exec_target CORE_MODE_MULT_save_to_PMEM
writeQ $(PATTERN)/qdata.txt
writeK0 $(PATTERN)/kdata_core0.txt
writeK1 $(PATTERN)/kdata_core1.txt
simulate
verifypmem

# Test 2: Norm(Q*K^T)
reset
set_exec_target CORE_MODE_MULT_NORM_save_to_PMEM_and_KMEM
writeQ $(PATTERN)/qdata.txt
simulate
verifypmem

# Test 3: V*Norm^T (KMEM has norm from Test 2)
reset
set_exec_target CORE_MODE_MULT_save_to_PMEM
writeQ $(PATTERN)/vdata.txt
simulate
verifypmem

exit
