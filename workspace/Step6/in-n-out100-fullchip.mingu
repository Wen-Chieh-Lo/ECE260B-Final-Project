# =============================================================================
#
#   in-n-out100-fullchip.mingu  —  Batch run random100 pattern sets (0..99) [fullchip_shell]
#
#   Dual-core: writeK0/writeK1. Uses same kdata for both cores (or gen_random_patterns --dual_core).
#
#   USAGE: ./sim_shell.sh -f in-n-out100-fullchip.mingu
#
#   set_clock_period <ns0> [ns1] — clk0 / clk1 period (ns)
#   set_dump_vcd 0 — disable VCD
#
# =============================================================================

set PATTERN sw/pattern/random100
set_output_dir sim/waveform
set_sim_stage sim
set_dump_vcd 0
set_clock_period 1 1.2
set_sim_define SFP_LONGDIV SFP_THRESHOLD=169503
set_scope fullchip
fix_set

for i = 0 to 99

	reset

	# Test 1: Q*K^T
	set_exec_target CORE_MODE_MULT_save_to_PMEM
	writeQ $(PATTERN)/qdata_$(i).txt
	writeK0 $(PATTERN)/kdata_$(i).txt
	writeK1 $(PATTERN)/kdata_$(i).txt
	simulate
	verifypmem

	# Test 2: Norm(Q*K^T)
	set_exec_target CORE_MODE_MULT_NORM_save_to_PMEM_and_KMEM
	writeQ $(PATTERN)/qdata_$(i).txt
	writeK0 $(PATTERN)/kdata_$(i).txt
	writeK1 $(PATTERN)/kdata_$(i).txt
	simulate
	verifypmem

	# Test 3: V*Norm^T
	set_exec_target CORE_MODE_MULT_save_to_PMEM
	writeQ $(PATTERN)/vdata_$(i).txt
	simulate
	verifypmem

endfor

exit
