database -open waves -into waves.shm -default
probe -create -shm fullchip_tb.clk0 fullchip_tb.clk1 fullchip_tb.reset fullchip_tb.fifo0_empty fullchip_tb.fifo1_empty fullchip_tb.out fullchip_tb.pmem_rd_c0 fullchip_tb.pmem_rd_c1 fullchip_tb.pmem_add_c0 fullchip_tb.pmem_add_c1 fullchip_tb.mismatch_prd_core0 fullchip_tb.mismatch_prd_core1 fullchip_tb.mismatch_vn_core0 fullchip_tb.mismatch_vn_core1
run
