database -open waves -into waves.shm -default
probe -create -shm core_tb.clk core_tb.reset core_tb.inst core_tb.qmem_wr core_tb.kmem_wr core_tb.qkmem_add core_tb.load core_tb.kmem_rd core_tb.execute core_tb.qmem_rd core_tb.sfp_acc core_tb.sfp_div core_tb.sfp_processing core_tb.pmem_out core_tb.pmem_rd core_tb.pmem_wr core_tb.pmem_add core_tb.ext_fifo_wr core_tb.ext_fifo_in core_tb.ext_fifo_rd core_tb.err core_tb.row_err core_tb.result core_tb.estimated
run
exit
