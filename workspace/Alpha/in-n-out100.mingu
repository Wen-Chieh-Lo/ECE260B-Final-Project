# =============================================================================
#
#   in-n-out100.mingu  —  Batch run random100 pattern sets (0..99)
#
#   Uses for-loop to iterate over pattern indices. Each iteration runs the
#   full attention pipeline (Q*K^T, Norm, V*Norm^T) like in-n-out.mingu.
#
#   USAGE: ./sim_shell.sh -f in-n-out100.mingu
#
# =============================================================================

set PATTERN sw/pattern/random100
set_output_dir sim/waveform
set_sim_stage sim
set_clock_period 1
set_sim_define SFP_LONGDIV
fix_set

	# Test 1: Q*K^T
	set_exec_target CORE_MODE_MULT_save_to_PMEM
	writeQ $(PATTERN)/qdata_0.txt
	writeK $(PATTERN)/kdata_0.txt
	simulate
	# verifypmem


for i = 0 to 99

	# Test 2: Norm(Q*K^T)
	set_exec_target CORE_MODE_MULT_NORM_save_to_PMEM_and_KMEM
	writeQ $(PATTERN)/qdata_$(i).txt
	writeK $(PATTERN)/kdata_$(i).txt
	simulate
	# verifypmem

	# Test 3: V*Norm^T
	set_exec_target CORE_MODE_MULT_save_to_PMEM
	writeQ $(PATTERN)/vdata_$(i).txt
	simulate
	verifypmem

endfor


exit
